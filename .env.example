# Google AI (Gemma) to OpenAI Protocol Proxy
# 环境变量配置示例文件
# 复制此文件为 .env 并填入实际配置值

# ========================================
# 必要配置 (Required)
# ========================================

# Google AI API Key (必需)
# 从 https://makersuite.google.com/app/apikey 获取
# 示例: GOOGLE_API_KEY=AIzaSyB4eT...
GOOGLE_API_KEY=your_google_ai_api_key_here

# ========================================
# 基础配置 (Basic Settings)
# ========================================

# 服务端口 (默认: 8787)
# 仅在 docker run 时使用，docker-compose 端口在 docker-compose.yml 中配置
PORT=8787

# 默认模型 (默认: gemma-4-31b-it)
# 支持的模型列表可通过 GET /v1/models 获取
DEFAULT_MODEL=gemma-4-31b-it

# 日志级别 (默认: INFO)
# 可选值: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ========================================
# 高级配置 (Advanced Settings)
# ========================================

# 模型缓存时间，单位秒 (默认: 300)
# 从 Google API 获取的模型列表缓存时间
CACHE_DURATION=300

# 请求超时时间，单位秒 (默认: 120)
# 与 Google AI API 通信的超时时间
REQUEST_TIMEOUT=120

# CORS 允许的来源 (默认: *)
# * 表示允许所有来源
# 多个来源用逗号分隔，如: https://app1.com,https://app2.com
CORS_ORIGINS=*

# 最大重试次数 (默认: 3)
# 请求失败时的自动重试次数
MAX_RETRIES=3

# 跳过 SSL 验证 (默认: true)
# 设置为 false 以启用 SSL 验证，true 表示跳过验证
SKIP_SSL_VERIFY=true

# 日志文件路径 (默认: /tmp/openai_proxy.log)
# 容器内建议使用 /tmp 或 /app/logs 目录
LOG_FILE=/tmp/openai_proxy.log

# ========================================
# Docker 相关配置 (Docker Settings)
# ========================================

# 镜像标签
# docker build -t google-ai-openai-proxy:latest .
IMAGE_TAG=latest

# 容器名称
CONTAINER_NAME=google-ai-openai-proxy

# 重启策略 (默认: unless-stopped)
# 可选值: no, on-failure, always, unless-stopped
RESTART_POLICY=unless-stopped

# ========================================
# 配置说明
# ========================================
# 1. 复制此文件: cp .env.example .env
# 2. 编辑 .env 文件，填入 GOOGLE_API_KEY
# 3. 其他变量可使用默认值，或根据需求调整
# 4. 敏感信息不要提交到版本控制
# ========================================
